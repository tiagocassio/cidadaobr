#!/usr/bin/env bash
# Topic names: Cidadaobr::KafkaTopics (hyphen-separated, no dots or underscores).
set -euo pipefail

BOOTSTRAP="${KAFKA_BOOTSTRAP_SERVERS:-localhost:9092}"
PARTITIONS="${KAFKA_TOPIC_PARTITIONS:-1}"
REPLICATION="${KAFKA_TOPIC_REPLICATION:-1}"

TOPICS=(
  appointment-booked
  appointment-cancelled
  appointment-checkedin
  appointment-completed
  appointment-noshow
  appointment-rescheduled
  campaign-targets-built
  care-team-created
  care-team-updated
  citizen-registered
  citizen-updated
  clinical-record-imported
  clinical-record-persisted
  clinical-record-validated
  clinical-record-validation-failed
  domain-outbox
  home-visit-route-generated
  home-visit-route-published
  immunobiological-lot-received
  indicator-gap-detected
  indicator-team-score-updated
  appointment-walk-in-booked
  ledi-batch-submitted
  ledi-batch-statuschanged
  reference-release-published
  supply-provisioning-rejected
  vaccination-campaign-draft-invalidated
  vaccination-campaign-published
  vaccination-provisioning-approved
  visit-route-supplies-dispatched
  visit-route-supplies-reserved
)

if command -v docker >/dev/null 2>&1 && docker compose ps kafka 2>/dev/null | grep -q "running\|Up"; then
  KAFKA_BIN="docker compose exec -T kafka /opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9092"
else
  KAFKA_BIN="kafka-topics.sh --bootstrap-server ${BOOTSTRAP}"
fi

echo "Creating Kafka topics (bootstrap=${BOOTSTRAP})..."
for topic in "${TOPICS[@]}"; do
  echo "  - ${topic}"
  ${KAFKA_BIN} --create --if-not-exists --topic "${topic}" \
    --partitions "${PARTITIONS}" \
    --replication-factor "${REPLICATION}" 2>/dev/null || true
done

echo "Done."
