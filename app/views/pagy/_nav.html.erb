<% if pagy.pages > 1 %>
  <nav class="pagy-nav mt-4 flex flex-wrap items-center gap-2 text-sm" aria-label="<%= t("cidadaobr.pagination.aria_label") %>">
    <% if pagy.prev %>
      <%= link_to t("cidadaobr.pagination.previous"), pagy_url_for(pagy, pagy.prev), class: "rounded border border-slate-300 px-3 py-1 hover:bg-slate-50" %>
    <% end %>

    <% pagy.series.each do |item| %>
      <% if item.is_a?(Integer) %>
        <% if item == pagy.page %>
          <span class="rounded bg-slate-900 px-3 py-1 text-white"><%= item %></span>
        <% else %>
          <%= link_to item, pagy_url_for(pagy, item), class: "rounded border border-slate-300 px-3 py-1 hover:bg-slate-50" %>
        <% end %>
      <% elsif item.is_a?(String) %>
        <span class="px-1 text-slate-400"><%= item %></span>
      <% end %>
    <% end %>

    <% if pagy.next %>
      <%= link_to t("cidadaobr.pagination.next"), pagy_url_for(pagy, pagy.next), class: "rounded border border-slate-300 px-3 py-1 hover:bg-slate-50" %>
    <% end %>

    <span class="ml-2 text-slate-500"><%= t("cidadaobr.pagination.page_of", page: pagy.page, pages: pagy.pages) %></span>
  </nav>
<% end %>
