<section>
  <div class="mb-6 flex items-center justify-between">
    <h2 class="text-2xl font-bold"><%= t("cidadaobr.health_facilities.index_title") %></h2>
    <%= link_to t("cidadaobr.health_facilities.new"), new_web_health_facility_path, class: "rounded bg-emerald-700 px-4 py-2 text-sm font-semibold text-white" %>
  </div>

  <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
    <table class="min-w-full text-sm">
      <thead class="bg-slate-50 text-left">
        <tr>
          <th class="px-4 py-3"><%= HealthFacility.human_attribute_name(:name) %></th>
          <th class="px-4 py-3"><%= HealthFacility.human_attribute_name(:cnes) %></th>
          <th class="px-4 py-3"><%= t("cidadaobr.health_facilities.type_label") %></th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody>
        <% @health_facilities.each do |facility| %>
          <tr class="border-t border-slate-100">
            <td class="px-4 py-3"><%= facility.name %></td>
            <td class="px-4 py-3"><%= facility.cnes %></td>
            <td class="px-4 py-3"><%= facility_service_kind_label(facility.facility_service_kind) %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to t("cidadaobr.common.view"), web_health_facility_path(facility), class: "text-emerald-700 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "web/shared/pagination" %>
</section>
