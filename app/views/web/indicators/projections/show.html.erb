<section>
  <div class="mb-6">
    <%= link_to t("cidadaobr.indicators.projections.back"), web_indicators_root_path(quadrimester: @quadrimester), class: "text-sm text-slate-600 underline" %>
    <h2 class="mt-2 text-2xl font-bold"><%= t("cidadaobr.indicators.projections.title") %></h2>
    <p class="text-slate-600"><%= t("cidadaobr.indicators.projections.subtitle", quadrimester: @quadrimester) %></p>
  </div>

  <div class="mb-8 rounded-lg border border-slate-200 bg-white p-4">
    <p class="text-sm text-slate-500"><%= t("cidadaobr.indicators.projections.total_stub") %></p>
    <p class="text-3xl font-bold">R$ <%= number_with_delimiter(format("%.2f", @total_projection), delimiter: ".", separator: ",") %></p>
  </div>

  <div class="rounded-lg border border-slate-200 bg-white p-6">
    <h3 class="mb-4 font-semibold"><%= t("cidadaobr.indicators.projections.by_team") %></h3>
    <ul class="divide-y divide-slate-100 text-sm">
      <% @teams.each do |team| %>
        <% rows = @by_team[team.id] || [] %>
        <% team_total = rows.sum { |row| row.projected_transfer.to_f } %>
        <li class="flex items-center justify-between py-2">
          <span><%= team.name %></span>
          <span>R$ <%= number_with_delimiter(format("%.2f", team_total), delimiter: ".", separator: ",") %></span>
        </li>
      <% end %>
    </ul>
  </div>
</section>
