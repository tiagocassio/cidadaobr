<section>
  <div class="mb-6">
    <%= link_to t("cidadaobr.indicators.teams.back"), web_indicators_root_path(quadrimester: @quadrimester), class: "text-sm text-slate-600 underline" %>
    <h2 class="mt-2 text-2xl font-bold"><%= @team.name %></h2>
    <p class="text-slate-600"><%= t("cidadaobr.indicators.dashboard.ine") %> <%= @team.ine %> — <%= @quadrimester %></p>
  </div>

  <div class="mb-8 rounded-lg border border-slate-200 bg-white p-6">
    <h3 class="mb-4 font-semibold"><%= t("cidadaobr.indicators.teams.scores_by_indicator") %></h3>
    <% if @results.any? %>
      <ul class="divide-y divide-slate-100 text-sm">
        <% @results.each do |result| %>
          <li class="flex items-center justify-between py-2">
            <span><%= indicator_catalog_name(result.indicator_code) %></span>
            <span><%= result.score %>% — <%= indicator_tier_label(result.tier) %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-slate-500"><%= t("cidadaobr.indicators.teams.no_scores") %></p>
    <% end %>
  </div>

  <div class="rounded-lg border border-slate-200 bg-white p-6">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <h3 class="font-semibold"><%= t("cidadaobr.indicators.teams.open_gaps") %></h3>
      <%= form_with url: web_indicators_team_path(@team), method: :get, class: "flex items-end gap-2" do |form| %>
        <%= form.hidden_field :quadrimester, value: @quadrimester %>
        <div>
          <%= form.label :indicator_code, t("cidadaobr.indicators.teams.filter_indicator"), class: "mb-1 block text-xs text-slate-600" %>
          <%= form.select :indicator_code,
                options_for_select(
                  [[t("cidadaobr.indicators.teams.all_indicators"), ""]] + @catalog_codes.map { |code| [indicator_catalog_name(code), code] },
                  params[:indicator_code]
                ),
                {},
                class: "rounded border border-slate-300 px-2 py-1 text-sm" %>
        </div>
        <%= form.submit t("cidadaobr.indicators.dashboard.filter"), class: "rounded bg-slate-900 px-3 py-1 text-sm text-white" %>
      <% end %>
    </div>
    <% if @open_gaps.any? %>
      <% @gaps_by_indicator.each do |indicator_code, gaps| %>
        <div class="mb-4">
          <p class="mb-2 text-sm font-medium text-slate-700">
            <%= indicator_catalog_name(indicator_code) %>
            <span class="text-slate-500">(<%= gaps.size %>)</span>
          </p>
          <ul class="divide-y divide-slate-100 text-sm">
            <% gaps.each do |gap| %>
              <li class="py-2">
                <% if gap.good_practice_code.present? %>
                  <%= t("cidadaobr.indicators.teams.good_practice") %> <%= good_practice_label(gap.good_practice_code) %> —
                <% end %>
                <span class="text-slate-600"><%= gap.citizen.full_name %></span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% else %>
      <p class="text-sm text-slate-500"><%= t("cidadaobr.indicators.teams.no_open_gaps") %></p>
    <% end %>
  </div>
</section>
