<section>
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h2 class="text-2xl font-bold"><%= t("cidadaobr.indicators.dashboard.title") %></h2>
      <p class="text-slate-600"><%= t("cidadaobr.indicators.dashboard.subtitle") %></p>
    </div>

    <%= form_with url: web_indicators_root_path, method: :get, class: "flex items-end gap-2" do |form| %>
      <div>
        <%= form.label :quadrimester, t("cidadaobr.indicators.dashboard.quadrimester_label"), class: "mb-1 block text-sm text-slate-600" %>
        <%= form.text_field :quadrimester, value: @quadrimester, class: "rounded border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <%= form.submit t("cidadaobr.indicators.dashboard.filter"), class: "rounded bg-slate-900 px-4 py-2 text-sm text-white" %>
    <% end %>
  </div>

  <div class="mb-8 grid gap-4 sm:grid-cols-3">
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-sm text-slate-500"><%= t("cidadaobr.indicators.dashboard.#{indicators_score_title_key}") %></p>
      <p class="text-2xl font-bold"><%= @scored_count %>/<%= @evaluated_indicator_count %></p>
      <p class="text-xs text-slate-500"><%= t("cidadaobr.indicators.dashboard.score_card_hint") %></p>
      <p class="text-xs text-slate-500"><%= t("cidadaobr.indicators.dashboard.catalog_total", count: @catalog_total) %></p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-sm text-slate-500"><%= t("cidadaobr.indicators.dashboard.open_gaps") %></p>
      <p class="text-2xl font-bold"><%= @open_gaps_count %></p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-sm text-slate-500"><%= t("cidadaobr.indicators.dashboard.monitored_teams") %></p>
      <p class="text-2xl font-bold"><%= @teams.count %></p>
    </div>
  </div>

  <div class="mb-8 rounded-lg border border-slate-200 bg-white p-6">
    <h3 class="mb-4 font-semibold"><%= t("cidadaobr.indicators.dashboard.#{indicators_average_title_key}") %></h3>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <% @catalog.each do |entry| %>
        <% score = @scores_by_indicator[entry.code] %>
        <div class="rounded border border-slate-100 px-3 py-2 text-sm">
          <p class="font-medium"><%= indicator_catalog_name(entry.code) %></p>
          <p class="text-xs text-slate-500"><%= entry.code %></p>
          <p class="text-slate-600"><%= score ? "#{score}%" : t("cidadaobr.indicators.dashboard.no_score") %></p>
        </div>
      <% end %>
    </div>
  </div>

  <div class="rounded-lg border border-slate-200 bg-white p-6">
    <div class="mb-4 flex items-center justify-between">
      <h3 class="font-semibold"><%= t("cidadaobr.indicators.dashboard.teams") %></h3>
      <% if municipality_scope? %>
        <%= link_to t("cidadaobr.indicators.dashboard.transfer_projection"), web_indicators_projections_path(quadrimester: @quadrimester), class: "text-sm text-slate-700 underline" %>
      <% end %>
    </div>
    <ul class="divide-y divide-slate-100">
      <% @ranked_teams.each_with_index do |team, index| %>
        <% avg = @team_average_scores[team.id] %>
        <li class="flex items-center justify-between py-2 text-sm">
          <span>
            <span class="text-slate-400"><%= index + 1 %>.</span>
            <%= team.name %> (<%= t("cidadaobr.indicators.dashboard.ine") %> <%= team.ine %>)
            <% if avg %>
              — <span class="font-medium"><%= avg %>%</span> <%= t("cidadaobr.indicators.dashboard.team_average") %>
            <% else %>
              — <span class="text-slate-500"><%= t("cidadaobr.indicators.dashboard.no_score") %></span>
            <% end %>
          </span>
          <%= link_to t("cidadaobr.indicators.dashboard.details"), web_indicators_team_path(team, quadrimester: @quadrimester), class: "text-slate-700 underline" %>
        </li>
      <% end %>
    </ul>
  </div>
</section>
