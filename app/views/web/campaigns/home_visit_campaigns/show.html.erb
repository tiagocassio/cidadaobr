<section>
  <%= link_to t("cidadaobr.campaigns.home_visit.back"), web_campaigns_home_visit_campaign_path(@campaign, route_date: params[:route_date]), class: "text-sm text-slate-600 underline" %>
  <h2 class="mt-2 mb-6 text-2xl font-bold"><%= @campaign.name %></h2>

  <% selectable_dates = (@route_dates + [ @route_date ]).uniq.sort %>
  <form method="get" class="mb-4 flex flex-wrap items-end gap-3 text-sm">
    <label class="flex flex-col gap-1">
      <span class="font-medium"><%= t("cidadaobr.campaigns.home_visit.route_date") %></span>
      <select name="route_date" class="rounded border border-slate-300 px-3 py-2">
        <% selectable_dates.each do |date| %>
          <option value="<%= date.iso8601 %>" <%= "selected" if date == @route_date %>><%= l(date) %></option>
        <% end %>
      </select>
    </label>
    <button type="submit" class="rounded border border-slate-300 px-3 py-2"><%= t("cidadaobr.campaigns.home_visit.apply_route_date") %></button>
  </form>

  <% route_date_param = { route_date: @route_date.iso8601 } %>
  <div class="mb-6 flex flex-wrap gap-2">
    <%= button_to t("cidadaobr.campaigns.build_targets_link"), build_targets_web_campaigns_home_visit_campaign_path(@campaign), method: :post, class: "rounded bg-slate-800 px-3 py-2 text-sm font-semibold text-white" %>
    <%= button_to t("cidadaobr.campaigns.home_visit.generate_routes"), generate_routes_web_campaigns_home_visit_campaign_path(@campaign, **route_date_param), method: :post, class: "rounded bg-emerald-700 px-3 py-2 text-sm font-semibold text-white" %>
    <% if @routes_for_date.any? %>
      <%= button_to t("cidadaobr.campaigns.home_visit.regenerate_routes"), generate_routes_web_campaigns_home_visit_campaign_path(@campaign, **route_date_param, regenerate: true), method: :post, class: "rounded bg-emerald-900 px-3 py-2 text-sm font-semibold text-white" %>
      <%= button_to t("cidadaobr.campaigns.home_visit.clear_routes"), clear_routes_web_campaigns_home_visit_campaign_path(@campaign, **route_date_param), method: :post, form: { data: { turbo_confirm: t("cidadaobr.campaigns.home_visit.confirm_clear_routes") } }, class: "rounded border border-red-300 px-3 py-2 text-sm text-red-700" %>
      <%= link_to t("cidadaobr.campaigns.home_visit.route_map"), route_map_web_campaigns_home_visit_campaign_path(@campaign, **route_date_param), class: "rounded border border-slate-300 px-3 py-2 text-sm" %>
      <% if @routes_for_date.any? { |route| route.status == "draft" } %>
        <%= button_to t("cidadaobr.campaigns.home_visit.publish_routes"), publish_routes_web_campaigns_home_visit_campaign_path(@campaign, **route_date_param), method: :post, class: "rounded bg-indigo-700 px-3 py-2 text-sm font-semibold text-white" %>
      <% end %>
    <% end %>
    <%= link_to t("cidadaobr.campaigns.home_visit.preview_provisioning"), preview_provisioning_web_campaigns_home_visit_campaign_path(@campaign), class: "rounded border border-slate-300 px-3 py-2 text-sm" %>
    <% if @provisioning_reserve_needed %>
      <%= button_to t("cidadaobr.campaigns.home_visit.reserve_provisioning"), reserve_provisioning_web_campaigns_home_visit_campaign_path(@campaign, all_routes: true, return_to: "show", route_date: @route_date.iso8601), method: :post, class: "rounded bg-amber-700 px-3 py-2 text-sm font-semibold text-white" %>
    <% end %>
  </div>

  <% if @provisioning_reserve_needed %>
    <p class="mb-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
      <%= t("cidadaobr.campaigns.home_visit.dispatch_reserve_hint") %>
    </p>
  <% end %>

  <div class="mb-6 rounded-lg border border-slate-200 bg-white p-6 text-sm">
    <p><strong><%= t("cidadaobr.campaigns.targets_count") %>:</strong> <%= @targets_count %></p>
    <p><strong><%= HomeVisitCampaign.human_attribute_name(:status) %>:</strong> <%= @campaign.status %></p>
    <p><strong><%= t("cidadaobr.campaigns.provisioning_status") %>:</strong> <%= @provisioning&.status || "—" %></p>
    <% if @routes_for_date.any? %>
      <p class="text-slate-600"><%= t("cidadaobr.campaigns.home_visit.provisioning_day_label", date: l(@route_date)) %> — <%= t("cidadaobr.campaigns.home_visit.provisioning_campaign_status_hint") %></p>
    <% end %>
    <% if @phase5_ready %>
      <p class="mt-2 font-semibold text-emerald-700"><%= t("cidadaobr.campaigns.home_visit.phase5_ready") %></p>
    <% end %>
  </div>

  <% if @campaign_progress.total_stops.positive? %>
    <div class="mb-6 rounded-lg border border-slate-200 bg-white p-6 text-sm">
      <h3 class="mb-2 font-semibold"><%= t("cidadaobr.campaigns.home_visit.team_progress_title") %></h3>
      <p class="mb-4"><%= t("cidadaobr.campaigns.home_visit.campaign_progress", visited: @campaign_progress.visited, total: @campaign_progress.total_stops, pct: @campaign_progress.completion_pct) %></p>
      <ul class="divide-y">
        <% @team_progress.each do |row| %>
          <li class="flex flex-wrap items-center justify-between gap-2 py-2">
            <span><%= row[:care_team_name] %></span>
            <span><%= row[:visited_stops] %> / <%= row[:total_stops] %> (<%= row[:completion_pct] %>%)</span>
            <% team_routes = @routes_for_date.select { |route| route.care_team_id == row[:care_team_id] && route.status == "published" } %>
            <% if team_routes.any? %>
              <% if team_routes.all? { |route| route.visit_route_provisioning&.status == "dispatched" } %>
                <span class="text-xs text-slate-500"><%= t("cidadaobr.campaigns.home_visit.dispatch_done") %></span>
              <% elsif team_routes.all? { |route| route.visit_route_provisioning&.status == "reserved" } %>
                <%= button_to t("cidadaobr.campaigns.home_visit.dispatch_supplies"), dispatch_supplies_web_campaigns_home_visit_campaign_path(@campaign, **route_date_param, care_team_id: row[:care_team_id]), method: :post, class: "rounded border border-slate-300 px-2 py-1 text-xs" %>
              <% else %>
                <span class="text-xs text-amber-800"><%= t("cidadaobr.campaigns.home_visit.dispatch_needs_reserve") %></span>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @routes_for_date.any? %>
    <div class="rounded-lg border border-slate-200 bg-white p-6">
      <h3 class="mb-4 font-semibold"><%= t("cidadaobr.campaigns.home_visit.routes_title") %></h3>
      <ul class="divide-y text-sm">
        <% @routes_for_date.each do |route| %>
          <li class="py-2">
            <%= route.route_date %> · <%= route.care_team.name %> · <%= route.visit_route_stops.count %> paradas · <%= route.status %>
            <% if route.visit_route_provisioning.present? %>
              · <%= t("cidadaobr.campaigns.provisioning_status") %>: <%= route.visit_route_provisioning.status %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</section>
