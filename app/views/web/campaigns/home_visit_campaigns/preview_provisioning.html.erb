<section>
  <%= link_to t("cidadaobr.campaigns.back"), web_campaigns_home_visit_campaign_path(@campaign, route_date: @route_date.iso8601), class: "text-sm text-slate-600 underline" %>
  <h2 class="mt-2 mb-2 text-2xl font-bold"><%= t("cidadaobr.campaigns.home_visit.preview_provisioning") %></h2>
  <p class="mb-6 text-sm font-medium text-slate-700"><%= t("cidadaobr.campaigns.home_visit.provisioning_day_label", date: l(@route_date)) %></p>

  <% selectable_dates = (@route_dates + [ @route_date ]).uniq.sort %>
  <% if selectable_dates.any? %>
    <%= form_with url: preview_provisioning_web_campaigns_home_visit_campaign_path(@campaign), method: :get, class: "mb-4 flex flex-wrap items-end gap-3 text-sm" do |form| %>
      <div class="flex flex-col gap-1">
        <%= form.label :route_date, t("cidadaobr.campaigns.home_visit.route_date"), class: "font-medium" %>
        <%= form.select :route_date,
              options_for_select(selectable_dates.map { |date| [l(date), date.iso8601] }, @route_date.iso8601),
              {},
              class: "rounded border border-slate-300 px-3 py-2" %>
      </div>
      <%= form.submit t("cidadaobr.campaigns.home_visit.apply_route_date"), class: "rounded border border-slate-300 px-3 py-2" %>
    <% end %>
    <p class="mb-4 text-sm text-slate-600"><%= t("cidadaobr.campaigns.home_visit.provisioning_route_date_hint") %></p>
  <% end %>

  <div class="mb-4 flex flex-wrap gap-2">
    <%= button_to t("cidadaobr.campaigns.home_visit.calculate_provisioning"), calculate_provisioning_web_campaigns_home_visit_campaign_path(@campaign, route_date: @route_date.iso8601), method: :post, class: "rounded bg-slate-800 px-3 py-2 text-sm font-semibold text-white" %>
    <% if @rollup&.status.in?(%w[calculated blocked]) && @rollup.totals_json.present? %>
      <%= button_to t("cidadaobr.campaigns.home_visit.reserve_provisioning"), reserve_provisioning_web_campaigns_home_visit_campaign_path(@campaign, all_routes: true), method: :post, class: "rounded bg-amber-700 px-3 py-2 text-sm font-semibold text-white" %>
    <% end %>
  </div>

  <div class="rounded-lg border border-slate-200 bg-white p-6 text-sm">
    <% if @rollup.present? %>
      <p class="mb-4">
        <%= t("cidadaobr.campaigns.home_visit.provisioning_status_for_day", date: l(@route_date)) %>:
        <strong><%= @rollup.status %></strong>
      </p>

      <% if @rollup.totals_json.blank? %>
        <p class="text-slate-600"><%= t("cidadaobr.campaigns.home_visit.provisioning_no_items") %></p>
      <% else %>
        <% editable = @rollup.status.in?(%w[calculated blocked]) %>
        <div class="overflow-x-auto">
          <% if editable %>
            <%= form_with url: update_provisioning_web_campaigns_home_visit_campaign_path(@campaign, route_date: @route_date.iso8601), method: :patch, class: "space-y-4" do |form| %>
              <table class="min-w-full text-sm">
                <thead class="bg-slate-50 text-left">
                  <tr>
                    <th class="px-4 py-3"><%= t("cidadaobr.campaigns.home_visit.item") %></th>
                    <th class="px-4 py-3"><%= t("cidadaobr.campaigns.home_visit.quantity_required") %></th>
                    <th class="px-4 py-3"><%= t("cidadaobr.campaigns.home_visit.quantity_available") %></th>
                    <th class="px-4 py-3"><%= t("cidadaobr.campaigns.home_visit.deficit") %></th>
                  </tr>
                </thead>
                <tbody>
                  <% @rollup.totals_json.each_with_index do |line, index| %>
                    <% line_fields = ActiveSupport::HashWithIndifferentAccess.new(line) %>
                    <tr class="border-t border-slate-100 <%= line['deficit'].to_i.positive? ? 'bg-red-50' : '' %>">
                      <%= form.fields_for :totals, line_fields, index: index do |line_form| %>
                        <td class="px-4 py-3">
                          <%= line["label"] %>
                          <%= line_form.hidden_field :key %>
                          <%= line_form.hidden_field :label %>
                          <%= line_form.hidden_field :unit %>
                          <%= line_form.hidden_field :supply_item_id %>
                          <%= line_form.hidden_field :immunobiological_product_id %>
                        </td>
                        <td class="px-4 py-3">
                          <%= line_form.number_field :quantity_required, min: 0, class: "w-24 rounded border border-slate-300 px-2 py-1" %>
                          <%= line["unit"] %>
                        </td>
                        <td class="px-4 py-3"><%= line["quantity_available"] || "—" %></td>
                        <td class="px-4 py-3"><%= line["deficit"].to_i.positive? ? line["deficit"] : "—" %></td>
                      <% end %>
                    </tr>
                  <% end %>
                </tbody>
              </table>
              <%= form.submit t("cidadaobr.campaigns.home_visit.save_provisioning"), class: "rounded border border-slate-300 px-3 py-2 text-sm" %>
            <% end %>
          <% else %>
            <table class="min-w-full text-sm">
              <thead class="bg-slate-50 text-left">
                <tr>
                  <th class="px-4 py-3"><%= t("cidadaobr.campaigns.home_visit.item") %></th>
                  <th class="px-4 py-3"><%= t("cidadaobr.campaigns.home_visit.quantity_required") %></th>
                  <th class="px-4 py-3"><%= t("cidadaobr.campaigns.home_visit.quantity_available") %></th>
                  <th class="px-4 py-3"><%= t("cidadaobr.campaigns.home_visit.deficit") %></th>
                </tr>
              </thead>
              <tbody>
                <% @rollup.totals_json.each do |line| %>
                  <tr class="border-t border-slate-100">
                    <td class="px-4 py-3"><%= line["label"] %></td>
                    <td class="px-4 py-3"><%= line["quantity_required"] %> <%= line["unit"] %></td>
                    <td class="px-4 py-3"><%= line["quantity_available"] || "—" %></td>
                    <td class="px-4 py-3"><%= line["deficit"].to_i.positive? ? line["deficit"] : "—" %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <p class="mb-4 text-slate-600"><%= t("cidadaobr.campaigns.home_visit.provisioning_not_calculated") %></p>
      <% if @lines.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead class="bg-slate-50 text-left">
              <tr>
                <th class="px-4 py-3"><%= t("cidadaobr.campaigns.home_visit.item") %></th>
                <th class="px-4 py-3"><%= t("cidadaobr.campaigns.home_visit.quantity") %></th>
              </tr>
            </thead>
            <tbody>
              <% @lines.each do |line| %>
                <tr class="border-t border-slate-100">
                  <td class="px-4 py-3"><%= line.label %></td>
                  <td class="px-4 py-3"><%= line.quantity_required %> <%= line.unit %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-slate-600"><%= t("cidadaobr.campaigns.home_visit.provisioning_no_items") %></p>
      <% end %>
    <% end %>
  </div>
</section>
