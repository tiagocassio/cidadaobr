<section>
  <%= link_to t("cidadaobr.campaigns.back"), web_campaigns_home_visit_campaign_path(@campaign), class: "text-sm text-slate-600 underline" %>
  <h2 class="mt-2 mb-6 text-2xl font-bold"><%= t("cidadaobr.campaigns.home_visit.preview_provisioning") %></h2>

  <div class="rounded-lg border border-slate-200 bg-white p-6 text-sm">
    <p class="mb-4"><%= t("cidadaobr.campaigns.provisioning_status") %>: <strong><%= @rollup.status %></strong></p>
    <table class="min-w-full">
      <thead>
        <tr class="text-left">
          <th class="py-2"><%= t("cidadaobr.campaigns.home_visit.item") %></th>
          <th class="py-2"><%= t("cidadaobr.campaigns.home_visit.quantity") %></th>
        </tr>
      </thead>
      <tbody>
        <% @rollup.totals_json.each do |line| %>
          <tr class="border-t">
            <td class="py-2"><%= line["label"] %></td>
            <td class="py-2"><%= line["quantity_required"] %> <%= line["unit"] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
