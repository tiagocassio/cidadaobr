<section>
  <%= link_to t("cidadaobr.campaigns.back"), web_campaigns_home_visit_campaign_path(@campaign, route_date: @route_date.iso8601), class: "text-sm text-slate-600 underline" %>
  <h2 class="mt-2 mb-2 text-2xl font-bold"><%= t("cidadaobr.campaigns.home_visit.preview_provisioning") %></h2>
  <p class="mb-6 text-sm font-medium text-slate-700"><%= t("cidadaobr.campaigns.home_visit.provisioning_day_label", date: l(@route_date)) %></p>

  <% selectable_dates = (@route_dates + [ @route_date ]).uniq.sort %>
  <% if selectable_dates.any? %>
    <form method="get" class="mb-4 flex flex-wrap items-end gap-3 text-sm">
      <label class="flex flex-col gap-1">
        <span class="font-medium"><%= t("cidadaobr.campaigns.home_visit.route_date") %></span>
        <select name="route_date" class="rounded border border-slate-300 px-3 py-2">
          <% selectable_dates.each do |date| %>
            <option value="<%= date.iso8601 %>" <%= "selected" if date == @route_date %>><%= l(date) %></option>
          <% end %>
        </select>
      </label>
      <button type="submit" class="rounded border border-slate-300 px-3 py-2"><%= t("cidadaobr.campaigns.home_visit.apply_route_date") %></button>
    </form>
    <p class="mb-4 text-sm text-slate-600"><%= t("cidadaobr.campaigns.home_visit.provisioning_route_date_hint") %></p>
  <% end %>

  <div class="mb-4 flex flex-wrap gap-2">
    <%= button_to t("cidadaobr.campaigns.home_visit.calculate_provisioning"), calculate_provisioning_web_campaigns_home_visit_campaign_path(@campaign, route_date: @route_date.iso8601), method: :post, class: "rounded bg-slate-800 px-3 py-2 text-sm font-semibold text-white" %>
    <% if @rollup&.status.in?(%w[calculated blocked]) %>
      <%= button_to t("cidadaobr.campaigns.home_visit.reserve_provisioning"), reserve_provisioning_web_campaigns_home_visit_campaign_path(@campaign, all_routes: true), method: :post, class: "rounded bg-amber-700 px-3 py-2 text-sm font-semibold text-white" %>
    <% end %>
  </div>

  <div class="rounded-lg border border-slate-200 bg-white p-6 text-sm">
    <% if @rollup.present? %>
      <p class="mb-4">
        <%= t("cidadaobr.campaigns.home_visit.provisioning_status_for_day", date: l(@route_date)) %>:
        <strong><%= @rollup.status %></strong>
      </p>

      <% editable = @rollup.status.in?(%w[calculated blocked]) %>
      <% if editable %>
        <%= form_with url: update_provisioning_web_campaigns_home_visit_campaign_path(@campaign, route_date: @route_date.iso8601), method: :patch, class: "space-y-4" do %>
          <table class="min-w-full">
            <thead>
              <tr class="text-left">
                <th class="py-2"><%= t("cidadaobr.campaigns.home_visit.item") %></th>
                <th class="py-2"><%= t("cidadaobr.campaigns.home_visit.quantity_required") %></th>
                <th class="py-2"><%= t("cidadaobr.campaigns.home_visit.quantity_available") %></th>
                <th class="py-2"><%= t("cidadaobr.campaigns.home_visit.deficit") %></th>
              </tr>
            </thead>
            <tbody>
              <% @rollup.totals_json.each_with_index do |line, index| %>
                <tr class="border-t <%= line['deficit'].to_i.positive? ? 'bg-red-50' : '' %>">
                  <td class="py-2">
                    <%= line["label"] %>
                    <%= hidden_field_tag "totals[#{index}][key]", line["key"] %>
                    <%= hidden_field_tag "totals[#{index}][label]", line["label"] %>
                    <%= hidden_field_tag "totals[#{index}][unit]", line["unit"] %>
                    <%= hidden_field_tag "totals[#{index}][supply_item_code]", line["supply_item_code"] %>
                    <%= hidden_field_tag "totals[#{index}][immunobiological_product_id]", line["immunobiological_product_id"] %>
                  </td>
                  <td class="py-2">
                    <%= number_field_tag "totals[#{index}][quantity_required]", line["quantity_required"], min: 0, class: "w-24 rounded border border-slate-300 px-2 py-1" %>
                    <%= line["unit"] %>
                  </td>
                  <td class="py-2"><%= line["quantity_available"] || "—" %></td>
                  <td class="py-2"><%= line["deficit"].to_i.positive? ? line["deficit"] : "—" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <%= submit_tag t("cidadaobr.campaigns.home_visit.save_provisioning"), class: "rounded border border-slate-300 px-3 py-2 text-sm" %>
        <% end %>
      <% else %>
        <table class="min-w-full">
          <thead>
            <tr class="text-left">
              <th class="py-2"><%= t("cidadaobr.campaigns.home_visit.item") %></th>
              <th class="py-2"><%= t("cidadaobr.campaigns.home_visit.quantity_required") %></th>
              <th class="py-2"><%= t("cidadaobr.campaigns.home_visit.quantity_available") %></th>
              <th class="py-2"><%= t("cidadaobr.campaigns.home_visit.deficit") %></th>
            </tr>
          </thead>
          <tbody>
            <% @rollup.totals_json.each do |line| %>
              <tr class="border-t">
                <td class="py-2"><%= line["label"] %></td>
                <td class="py-2"><%= line["quantity_required"] %> <%= line["unit"] %></td>
                <td class="py-2"><%= line["quantity_available"] || "—" %></td>
                <td class="py-2"><%= line["deficit"].to_i.positive? ? line["deficit"] : "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    <% else %>
      <p class="mb-4 text-slate-600"><%= t("cidadaobr.campaigns.home_visit.provisioning_not_calculated") %></p>
      <table class="min-w-full">
        <thead>
          <tr class="text-left">
            <th class="py-2"><%= t("cidadaobr.campaigns.home_visit.item") %></th>
            <th class="py-2"><%= t("cidadaobr.campaigns.home_visit.quantity") %></th>
          </tr>
        </thead>
        <tbody>
          <% @lines.each do |line| %>
            <tr class="border-t">
              <td class="py-2"><%= line.label %></td>
              <td class="py-2"><%= line.quantity_required %> <%= line.unit %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</section>
