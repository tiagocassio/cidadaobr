<section>
  <%= link_to t("cidadaobr.campaigns.back"), web_campaigns_vaccination_campaign_path(campaign), class: "text-sm text-slate-600 underline" %>
  <h2 class="mt-2 mb-6 text-2xl font-bold"><%= t("cidadaobr.campaigns.vaccination_wizard.step_targets_publish") %></h2>

  <div class="mb-4 flex flex-wrap gap-2">
    <%= button_to t("cidadaobr.campaigns.build_targets_link"),
          update_wizard_web_campaigns_vaccination_campaign_path(campaign, step: 4),
          method: :patch,
          class: "rounded bg-slate-800 px-3 py-2 text-sm font-semibold text-white" %>
    <% if campaign.supply_provisioning&.status == "approved" && campaign.campaign_targets.any? %>
      <%= button_to t("cidadaobr.campaigns.publish_link"),
            publish_web_campaigns_vaccination_campaign_path(campaign),
            method: :post,
            class: "rounded bg-emerald-700 px-3 py-2 text-sm font-semibold text-white" %>
    <% end %>
  </div>

  <div class="rounded-lg border border-slate-200 bg-white p-6 text-sm">
    <p class="mb-2"><%= t("cidadaobr.campaigns.targets_count") %>: <strong><%= campaign.campaign_targets.count %></strong></p>
    <% if targets_preview&.any? %>
      <ul class="divide-y">
        <% targets_preview.each do |target| %>
          <li class="py-2"><%= target.citizen.full_name %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-slate-600"><%= t("cidadaobr.campaigns.vaccination_wizard.no_targets_yet") %></p>
    <% end %>
  </div>
</section>
