<section>
  <%= link_to t("cidadaobr.campaigns.back"), web_campaigns_vaccination_campaign_path(@campaign), class: "text-sm text-slate-600 underline" %>
  <h2 class="mt-2 mb-6 text-2xl font-bold"><%= t("cidadaobr.campaigns.preview_targets_title") %></h2>

  <div class="rounded-lg border border-slate-200 bg-white p-6 text-sm">
    <p class="mb-4"><%= t("cidadaobr.campaigns.preview_targets_count", count: @preview_count) %></p>
    <pre class="overflow-auto rounded bg-slate-50 p-4 text-xs"><%= JSON.pretty_generate(@definition) %></pre>
    <%= button_to t("cidadaobr.campaigns.build_targets_link"), build_targets_web_campaigns_vaccination_campaign_path(@campaign), method: :post, class: "mt-4 rounded bg-emerald-700 px-4 py-2 font-semibold text-white" %>
  </div>
</section>
