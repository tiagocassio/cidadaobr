<nav class="mb-6 rounded-lg border border-slate-200 bg-white p-4 text-sm" aria-label="<%= t("cidadaobr.campaigns.vaccination_wizard.title") %>">
  <h3 class="mb-3 font-semibold"><%= t("cidadaobr.campaigns.vaccination_wizard.title") %></h3>
  <ol class="grid gap-2 sm:grid-cols-4">
    <% steps = [
      [1, t("cidadaobr.campaigns.vaccination_wizard.step_define")],
      [2, t("cidadaobr.campaigns.vaccination_wizard.step_audience")],
      [3, t("cidadaobr.campaigns.vaccination_wizard.step_provisioning")],
      [4, t("cidadaobr.campaigns.vaccination_wizard.step_targets_publish")]
    ] %>
    <% completion_step = local_assigns.fetch(:completion_step, 0) %>
    <% steps.each do |number, label| %>
      <% active = number == step %>
      <% done = campaign.persisted? && number <= completion_step && !active %>
      <% css = if active
        "border-emerald-600 bg-emerald-50 text-emerald-900"
      elsif done
        "border-emerald-300 bg-white text-emerald-800"
      else
        "border-slate-200 bg-slate-50 text-slate-500"
      end %>
      <li class="rounded border px-3 py-2 <%= css %>">
        <span class="font-medium"><%= number %>.</span> <%= label %>
      </li>
    <% end %>
  </ol>
</nav>
