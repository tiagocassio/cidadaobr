<section>
  <%= link_to t("cidadaobr.campaigns.back"), web_campaigns_vaccination_campaigns_path, class: "text-sm text-slate-600 underline" %>
  <h2 class="mt-2 mb-6 text-2xl font-bold"><%= t("cidadaobr.campaigns.vaccination_wizard.step_define") %></h2>

  <% wizard_url = @campaign.persisted? ? web_campaigns_vaccination_campaign_path(@campaign) : web_campaigns_vaccination_campaigns_path %>
  <% wizard_method = @campaign.persisted? ? :patch : :post %>

  <%= form_with model: [:web, :campaigns, @campaign],
                url: wizard_url,
                method: wizard_method,
                class: "max-w-xl space-y-4 rounded-lg border border-slate-200 bg-white p-6" do |form| %>
    <% if @campaign.errors.any? %>
      <div class="rounded bg-red-50 px-4 py-2 text-sm text-red-800"><%= @campaign.errors.full_messages.to_sentence %></div>
    <% end %>

    <div>
      <%= form.label :name, class: "mb-1 block text-sm font-medium" %>
      <%= form.text_field :name, required: true, class: "w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :health_facility_id, class: "mb-1 block text-sm font-medium" %>
      <%= form.collection_select :health_facility_id, @facilities, :id, :name, {}, class: "w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :immunobiological_product_id, class: "mb-1 block text-sm font-medium" %>
      <%= form.collection_select :immunobiological_product_id, @products, :id, :name, {}, class: "w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :consultation_room_id, class: "mb-1 block text-sm font-medium" %>
      <%= form.collection_select :consultation_room_id, @rooms, :id, :name, { include_blank: t("cidadaobr.campaigns.no_room") }, class: "w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :campaign_kind, class: "mb-1 block text-sm font-medium" %>
      <%= form.select :campaign_kind, VaccinationCampaign::CAMPAIGN_KINDS, {}, class: "w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :starts_on, class: "mb-1 block text-sm font-medium" %>
        <%= form.date_field :starts_on, required: true, class: "w-full rounded border border-slate-300 px-3 py-2" %>
      </div>
      <div>
        <%= form.label :ends_on, class: "mb-1 block text-sm font-medium" %>
        <%= form.date_field :ends_on, required: true, class: "w-full rounded border border-slate-300 px-3 py-2" %>
      </div>
    </div>
    <div>
      <%= form.label :room_capacity_per_day, class: "mb-1 block text-sm font-medium" %>
      <%= form.number_field :room_capacity_per_day, min: 0, step: 1, class: "w-full rounded border border-slate-300 px-3 py-2" %>
    </div>

    <%= form.submit t("cidadaobr.campaigns.vaccination_wizard.continue"), class: "rounded bg-emerald-700 px-4 py-2 font-semibold text-white" %>
  <% end %>
</section>
