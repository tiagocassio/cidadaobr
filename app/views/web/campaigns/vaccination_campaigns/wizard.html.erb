<%= render "wizard_nav", step: @step, campaign: @campaign, completion_step: @wizard_completion_step || 0 %>

<% case @step %>
<% when 1 %>
  <%= render "wizard_step1" %>
<% when 2 %>
  <%= render "wizard_step2" %>
<% when 3 %>
  <%= render "wizard_step3" %>
<% when 4 %>
  <%= render "wizard_step4" %>
<% end %>
