<section>
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h2 class="text-2xl font-bold"><%= t("cidadaobr.appointments.utilization_title") %></h2>
      <p class="text-sm text-slate-600"><%= t("cidadaobr.appointments.utilization_subtitle") %></p>
    </div>
    <%= link_to t("cidadaobr.appointments.back_to_schedule"), web_appointments_path(facility_scope_params), class: "rounded border border-slate-300 px-4 py-2 text-sm" %>
  </div>

  <%= form_with url: utilization_web_appointments_path, method: :get, class: "mb-6 flex flex-wrap items-end gap-3" do |form| %>
    <%= form.hidden_field :health_facility_id, value: params[:health_facility_id] if params[:health_facility_id].present? %>
    <div>
      <%= form.label :from_date, t("cidadaobr.appointments.utilization_from"), class: "mb-1 block text-sm text-slate-600" %>
      <%= form.date_field :from_date, value: @from_date.iso8601, class: "rounded border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= form.label :to_date, t("cidadaobr.appointments.utilization_to"), class: "mb-1 block text-sm text-slate-600" %>
      <%= form.date_field :to_date, value: @to_date.iso8601, class: "rounded border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <%= form.submit t("cidadaobr.appointments.utilization_filter"), class: "rounded bg-slate-900 px-4 py-2 text-sm text-white" %>
  <% end %>

  <div class="mb-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-sm text-slate-500"><%= t("cidadaobr.appointments.utilization_total") %></p>
      <p class="text-2xl font-bold"><%= @report[:total_appointments] %></p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-sm text-slate-500"><%= t("cidadaobr.appointments.utilization_no_show") %></p>
      <p class="text-2xl font-bold"><%= @report[:no_show_count] %> <span class="text-sm font-normal text-slate-500">(<%= @report[:no_show_rate] %>%)</span></p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-sm text-slate-500"><%= t("cidadaobr.appointments.utilization_completed") %></p>
      <p class="text-2xl font-bold"><%= @report[:completed_count] %> <span class="text-sm font-normal text-slate-500">(<%= @report[:completion_rate] %>%)</span></p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-sm text-slate-500"><%= t("cidadaobr.appointments.utilization_slot_rate") %></p>
      <p class="text-2xl font-bold"><%= @report[:slot_utilization_rate] %>%</p>
      <p class="text-xs text-slate-500"><%= @report[:slot_booked_total] %>/<%= @report[:slot_capacity_total] %> <%= t("cidadaobr.appointments.utilization_slots") %></p>
    </div>
  </div>

  <div class="rounded-lg border border-slate-200 bg-white p-6">
    <h3 class="mb-4 font-semibold"><%= t("cidadaobr.appointments.utilization_by_status") %></h3>
    <ul class="divide-y divide-slate-100 text-sm">
      <% Appointment::STATUSES.each do |status| %>
        <% count = @report[:status_counts].fetch(status, 0) %>
        <li class="flex items-center justify-between py-2">
          <span><%= appointment_status_label(status) %></span>
          <span><%= count %></span>
        </li>
      <% end %>
    </ul>
  </div>
</section>
