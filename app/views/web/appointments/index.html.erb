<section>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div>
      <h2 class="text-2xl font-bold"><%= t("cidadaobr.appointments.index_title") %></h2>
      <p class="text-sm text-slate-600"><%= l(@schedule[:date], format: :long) %></p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to t("cidadaobr.appointments.previous_day"), web_appointments_path(facility_scope_params.merge(date: @schedule[:date] - 1.day)), class: "rounded border border-slate-300 px-3 py-2 text-sm" %>
      <%= link_to t("cidadaobr.appointments.today"), web_appointments_path(facility_scope_params.merge(date: Date.current)), class: "rounded border border-slate-300 px-3 py-2 text-sm" %>
      <%= link_to t("cidadaobr.appointments.next_day"), web_appointments_path(facility_scope_params.merge(date: @schedule[:date] + 1.day)), class: "rounded border border-slate-300 px-3 py-2 text-sm" %>
      <%= link_to t("cidadaobr.appointments.new_booking"), new_web_appointment_path(facility_scope_params), class: "rounded bg-emerald-700 px-4 py-2 text-sm font-semibold text-white" %>
      <%= link_to t("cidadaobr.appointments.reception_queue"), reception_web_appointments_path(facility_scope_params), class: "rounded border border-slate-300 px-4 py-2 text-sm" %>
      <%= link_to t("cidadaobr.appointments.utilization_report"), utilization_web_appointments_path(facility_scope_params), class: "rounded border border-slate-300 px-4 py-2 text-sm" %>
    </div>
  </div>

  <div class="mb-8 overflow-hidden rounded-lg border border-slate-200 bg-white">
    <h3 class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold"><%= t("cidadaobr.appointments.capacity_by_room") %></h3>
    <table class="min-w-full text-sm">
      <thead class="bg-slate-50 text-left">
        <tr>
          <th class="px-4 py-3"><%= t("cidadaobr.appointments.table.time") %></th>
          <th class="px-4 py-3"><%= t("cidadaobr.appointments.table.room") %></th>
          <th class="px-4 py-3"><%= t("cidadaobr.appointments.table.occupancy") %></th>
        </tr>
      </thead>
      <tbody>
        <% @schedule[:capacity_slots].each do |slot| %>
          <tr class="border-t border-slate-100">
            <td class="px-4 py-3"><%= slot.starts_at.strftime("%H:%M") %>–<%= slot.ends_at.strftime("%H:%M") %></td>
            <td class="px-4 py-3"><%= slot.consultation_room.name %></td>
            <td class="px-4 py-3"><%= slot.booked_count %>/<%= slot.capacity %></td>
          </tr>
        <% end %>
        <% if @schedule[:capacity_slots].empty? %>
          <tr class="border-t border-slate-100">
            <td class="px-4 py-3 text-slate-500" colspan="3"><%= t("cidadaobr.appointments.no_slots") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
    <h3 class="border-b border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold"><%= t("cidadaobr.appointments.daily_appointments") %></h3>
    <table class="min-w-full text-sm">
      <thead class="bg-slate-50 text-left">
        <tr>
          <th class="px-4 py-3"><%= t("cidadaobr.appointments.table.time") %></th>
          <th class="px-4 py-3"><%= t("cidadaobr.appointments.table.citizen") %></th>
          <th class="px-4 py-3"><%= t("cidadaobr.appointments.table.service") %></th>
          <th class="px-4 py-3"><%= t("cidadaobr.appointments.table.status") %></th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody>
        <% @schedule[:appointments].each do |appointment| %>
          <tr class="border-t border-slate-100">
            <td class="px-4 py-3"><%= appointment.scheduled_at.strftime("%d/%m %H:%M") %></td>
            <td class="px-4 py-3"><%= appointment.citizen.full_name.presence || appointment.citizen.cpf %></td>
            <td class="px-4 py-3"><%= appointment.appointment_service_type.name %></td>
            <td class="px-4 py-3"><%= appointment_status_label(appointment.status) %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to t("cidadaobr.appointments.view"), web_appointment_path(appointment), class: "text-emerald-700 hover:underline" %>
            </td>
          </tr>
        <% end %>
        <% if @schedule[:appointments].empty? %>
          <tr class="border-t border-slate-100">
            <td class="px-4 py-3 text-slate-500" colspan="5"><%= t("cidadaobr.appointments.no_appointments") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
