<section>
  <h2 class="mb-2 text-2xl font-bold"><%= t("cidadaobr.appointments.show_title") %></h2>
  <p class="mb-6 text-slate-600"><%= @appointment.citizen.full_name %> · <%= @appointment.scheduled_at.strftime("%d/%m/%Y %H:%M") %></p>

  <div class="rounded-lg border border-slate-200 bg-white p-6 text-sm space-y-2">
    <p><strong><%= t("cidadaobr.appointments.status") %>:</strong> <%= appointment_status_label(@appointment.status) %></p>
    <p><strong><%= t("cidadaobr.appointments.service") %>:</strong> <%= @appointment.appointment_service_type.name %></p>
    <p><strong><%= t("cidadaobr.appointments.room") %>:</strong> <%= @appointment.consultation_room.name %></p>
    <p><strong><%= t("cidadaobr.appointments.channel") %>:</strong> <%= appointment_channel_label(@appointment.channel) %></p>
  </div>

  <div class="mt-4 flex flex-wrap gap-2">
    <% if @appointment.status.in?(%w[scheduled confirmed]) %>
      <%= button_to t("cidadaobr.appointments.cancel"), cancel_web_appointment_path(@appointment), class: "rounded border border-red-300 px-4 py-2 text-sm text-red-700", form: { data: { turbo_confirm: t("cidadaobr.appointments.confirm_cancel") } } %>
      <%= button_to t("cidadaobr.appointments.no_show"), no_show_web_appointment_path(@appointment), class: "rounded border border-amber-300 px-4 py-2 text-sm text-amber-800", form: { data: { turbo_confirm: t("cidadaobr.appointments.confirm_no_show") } } %>
    <% elsif @appointment.status.in?(%w[checked_in in_progress]) %>
      <%= button_to t("cidadaobr.appointments.no_show"), no_show_web_appointment_path(@appointment), class: "rounded border border-amber-300 px-4 py-2 text-sm text-amber-800", form: { data: { turbo_confirm: t("cidadaobr.appointments.confirm_no_show") } } %>
    <% end %>
  </div>

  <% if @reschedule_slots.present? %>
    <div class="mt-8 rounded-lg border border-slate-200 bg-white p-6">
      <h3 class="mb-4 text-lg font-semibold"><%= t("cidadaobr.appointments.reschedule") %></h3>
      <%= form_with url: reschedule_web_appointment_path(@appointment), method: :post, class: "flex flex-wrap items-end gap-4" do |form| %>
        <div>
          <%= form.label :room_capacity_slot_id, t("cidadaobr.appointments.new_time"), class: "mb-1 block text-sm font-medium" %>
          <%= form.collection_select :room_capacity_slot_id,
                                     @reschedule_slots,
                                     :id,
                                     ->(slot) { "#{slot.starts_at.strftime('%H:%M')} · #{slot.consultation_room.name} (#{slot.booked_count}/#{slot.capacity})" },
                                     {},
                                     class: "rounded border border-slate-300 px-3 py-2 text-sm",
                                     required: true %>
        </div>
        <%= form.submit t("cidadaobr.appointments.reschedule"), class: "rounded bg-emerald-700 px-4 py-2 text-sm font-semibold text-white" %>
      <% end %>
    </div>
  <% end %>
</section>
