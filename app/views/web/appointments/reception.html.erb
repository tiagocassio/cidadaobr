<section>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <h2 class="text-2xl font-bold"><%= t("cidadaobr.appointments.reception_title") %></h2>
    <div class="flex gap-2">
      <%= link_to t("cidadaobr.appointments.walk_in_title"), walk_in_web_appointments_path(facility_scope_params), class: "rounded bg-slate-800 px-4 py-2 text-sm font-semibold text-white" %>
      <%= link_to t("cidadaobr.appointments.back_to_schedule"), web_appointments_path(facility_scope_params), class: "rounded border border-slate-300 px-4 py-2 text-sm" %>
    </div>
  </div>

  <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
    <table class="min-w-full text-sm">
      <thead class="bg-slate-50 text-left">
        <tr>
          <th class="px-4 py-3"><%= t("cidadaobr.appointments.table.time") %></th>
          <th class="px-4 py-3"><%= t("cidadaobr.appointments.table.citizen") %></th>
          <th class="px-4 py-3"><%= t("cidadaobr.appointments.table.service") %></th>
          <th class="px-4 py-3"><%= t("cidadaobr.appointments.table.status") %></th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody>
        <% @appointments.each do |appointment| %>
          <tr class="border-t border-slate-100">
            <td class="px-4 py-3"><%= l(appointment.scheduled_at, format: :short) %></td>
            <td class="px-4 py-3"><%= appointment.citizen.full_name.presence || appointment.citizen.cpf %></td>
            <td class="px-4 py-3"><%= appointment.appointment_service_type.name %></td>
            <td class="px-4 py-3"><%= appointment_status_label(appointment.status) %></td>
            <td class="px-4 py-3 text-right space-x-2">
              <% if appointment.status.in?(%w[scheduled confirmed]) %>
                <%= button_to t("cidadaobr.appointments.check_in"), check_in_web_appointment_path(appointment), class: "text-emerald-700 hover:underline" %>
                <%= button_to t("cidadaobr.appointments.cancel"), cancel_web_appointment_path(appointment), class: "text-red-700 hover:underline", form: { data: { turbo_confirm: t("cidadaobr.appointments.confirm_cancel") } } %>
              <% elsif appointment.status.in?(%w[checked_in in_progress]) %>
                <%= button_to t("cidadaobr.appointments.complete"), complete_web_appointment_path(appointment), class: "text-emerald-700 hover:underline" %>
              <% end %>
              <% if appointment.status.in?(%w[scheduled confirmed checked_in in_progress]) %>
                <%= button_to t("cidadaobr.appointments.no_show"), no_show_web_appointment_path(appointment), class: "text-amber-700 hover:underline", form: { data: { turbo_confirm: t("cidadaobr.appointments.confirm_no_show") } } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
