<section>
  <h2 class="mb-6 text-2xl font-bold"><%= @care_team.persisted? ? @care_team.name : t("cidadaobr.care_teams.new_title") %></h2>

  <%= form_with model: [:web, @care_team], class: "max-w-xl space-y-4 rounded-lg border border-slate-200 bg-white p-6" do |form| %>
    <% if @care_team.errors.any? %>
      <div class="rounded bg-red-50 px-4 py-2 text-sm text-red-800"><%= @care_team.errors.full_messages.to_sentence %></div>
    <% end %>

    <div>
      <%= form.label :name, class: "mb-1 block text-sm font-medium" %>
      <%= form.text_field :name, required: true, class: "w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :ine, class: "mb-1 block text-sm font-medium" %>
      <%= form.text_field :ine, required: true, class: "w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
    <% if municipality_scope? %>
      <div>
        <%= form.label :health_facility_id, class: "mb-1 block text-sm font-medium" %>
        <%= form.collection_select :health_facility_id, @health_facilities, :id, :name, {}, class: "w-full rounded border border-slate-300 px-3 py-2" %>
      </div>
    <% end %>
    <%= form.submit t("cidadaobr.common.save"), class: "rounded bg-emerald-700 px-4 py-2 font-semibold text-white" %>
  <% end %>
</section>
