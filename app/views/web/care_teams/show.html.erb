<section>
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h2 class="text-2xl font-bold"><%= @care_team.name %></h2>
      <p class="text-slate-600"><%= CareTeam.human_attribute_name(:ine) %> <%= @care_team.ine %> — <%= health_facility_name_for(@care_team) %></p>
    </div>
    <% if municipality_scope? || facility_scope? %>
      <%= link_to t("cidadaobr.common.edit"), edit_web_care_team_path(@care_team), class: "rounded border border-slate-300 px-4 py-2 text-sm" %>
    <% end %>
  </div>
</section>
