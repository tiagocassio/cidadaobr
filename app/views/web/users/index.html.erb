<section>
  <div class="mb-6 flex items-center justify-between">
    <h2 class="text-2xl font-bold"><%= t("cidadaobr.users.index_title") %></h2>
    <%= link_to t("cidadaobr.users.new"), new_web_user_path, class: "rounded bg-emerald-700 px-4 py-2 text-sm font-semibold text-white" %>
  </div>

  <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
    <table class="min-w-full text-sm">
      <thead class="bg-slate-50 text-left">
        <tr>
          <th class="px-4 py-3"><%= User.human_attribute_name(:full_name) %></th>
          <th class="px-4 py-3"><%= User.human_attribute_name(:email) %></th>
          <th class="px-4 py-3"><%= UserMunicipalityMembership.human_attribute_name(:scope) %></th>
          <th class="px-4 py-3"><%= UserMunicipalityMembership.human_attribute_name(:role_code) %></th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody>
        <% @memberships.each do |membership| %>
          <tr class="border-t border-slate-100">
            <td class="px-4 py-3"><%= membership.user.full_name %></td>
            <td class="px-4 py-3"><%= membership.user.email %></td>
            <td class="px-4 py-3"><%= membership_scope_label(membership.scope) %></td>
            <td class="px-4 py-3"><%= membership_role_label(membership.role_code) %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to t("cidadaobr.common.edit"), edit_web_user_path(membership.user), class: "text-emerald-700 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "web/shared/pagination" %>
</section>
