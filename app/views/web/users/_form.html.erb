<section>
  <h2 class="mb-6 text-2xl font-bold"><%= @user.persisted? ? @user.full_name : "Novo usuário" %></h2>

  <%= form_with model: [:web, @user], class: "max-w-xl space-y-4 rounded-lg border border-slate-200 bg-white p-6" do |form| %>
    <% if @user.errors.any? || @membership&.errors&.any? %>
      <div class="rounded bg-red-50 px-4 py-2 text-sm text-red-800">
        <%= (@user.errors.full_messages + Array(@membership&.errors&.full_messages)).to_sentence %>
      </div>
    <% end %>

    <div>
      <%= form.label :full_name, "Nome", class: "mb-1 block text-sm font-medium" %>
      <%= form.text_field :full_name, required: true, class: "w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :email, "E-mail", class: "mb-1 block text-sm font-medium" %>
      <%= form.email_field :email, required: true, class: "w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :password, "Senha", class: "mb-1 block text-sm font-medium" %>
      <%= form.password_field :password, required: @user.new_record?, class: "w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :password_confirmation, "Confirmar senha", class: "mb-1 block text-sm font-medium" %>
      <%= form.password_field :password_confirmation, class: "w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
    <% if @user.persisted? %>
      <div>
        <%= form.label :active, class: "inline-flex items-center gap-2 text-sm" do %>
          <%= form.check_box :active %>
          Ativo
        <% end %>
      </div>
    <% end %>

    <%= fields_for :user_municipality_membership, @membership do |membership_form| %>
      <div>
        <%= membership_form.label :scope, "Escopo", class: "mb-1 block text-sm font-medium" %>
        <%= membership_form.select :scope, [["Município", "municipality"], ["UBS", "facility"]], {}, class: "w-full rounded border border-slate-300 px-3 py-2" %>
      </div>
      <div>
        <%= membership_form.label :role_code, "Papel", class: "mb-1 block text-sm font-medium" %>
        <%= membership_form.select :role_code,
          UserMunicipalityMembership::WEB_ROLE_CODES.map { |code| [ code.humanize, code ] },
          {},
          class: "w-full rounded border border-slate-300 px-3 py-2" %>
      </div>
      <div>
        <%= membership_form.label :health_facility_id, "UBS", class: "mb-1 block text-sm font-medium" %>
        <%= membership_form.collection_select :health_facility_id, @health_facilities, :id, :name, { include_blank: "—" }, class: "w-full rounded border border-slate-300 px-3 py-2" %>
      </div>
      <% if @user.persisted? %>
        <div>
          <%= membership_form.label :active, class: "inline-flex items-center gap-2 text-sm" do %>
            <%= membership_form.check_box :active %>
            Vínculo ativo
          <% end %>
        </div>
      <% end %>
    <% end %>

    <%= form.submit "Salvar", class: "rounded bg-emerald-700 px-4 py-2 font-semibold text-white" %>
  <% end %>
</section>
