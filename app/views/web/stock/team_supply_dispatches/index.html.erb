<section>
  <div class="mb-6 flex items-center justify-between">
    <h2 class="text-2xl font-bold"><%= t("cidadaobr.stock.dispatches.title") %></h2>
  </div>

  <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
    <table class="min-w-full text-sm">
      <thead class="bg-slate-50 text-left">
        <tr>
          <th class="px-4 py-3"><%= TeamSupplyDispatch.human_attribute_name(:dispatch_date) %></th>
          <th class="px-4 py-3"><%= CareTeam.model_name.human %></th>
          <th class="px-4 py-3"><%= HealthFacility.model_name.human %></th>
          <th class="px-4 py-3"><%= TeamSupplyDispatch.human_attribute_name(:status) %></th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody>
        <% @dispatches.each do |dispatch| %>
          <tr class="border-t">
            <td class="px-4 py-3"><%= l(dispatch.dispatch_date) %></td>
            <td class="px-4 py-3"><%= dispatch.care_team.name %></td>
            <td class="px-4 py-3"><%= dispatch.health_facility.name %></td>
            <td class="px-4 py-3"><%= dispatch.status %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to t("cidadaobr.stock.dispatches.view"), web_stock_team_supply_dispatch_path(dispatch), class: "text-emerald-700 underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</section>
