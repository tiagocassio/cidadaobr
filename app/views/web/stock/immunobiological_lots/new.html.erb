<section>
  <h2 class="mb-6 text-2xl font-bold"><%= t("cidadaobr.stock.lots.new_title") %></h2>

  <%= form_with model: @lot, url: web_stock_immunobiological_lots_path, class: "max-w-xl space-y-4 rounded-lg border border-slate-200 bg-white p-6" do |form| %>
    <% if @lot.errors.any? %>
      <div class="rounded bg-red-50 px-4 py-2 text-sm text-red-800"><%= @lot.errors.full_messages.to_sentence %></div>
    <% end %>

    <div>
      <%= form.label :health_facility_id, class: "mb-1 block text-sm font-medium" %>
      <%= form.collection_select :health_facility_id, @facilities, :id, :name, {}, class: "w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :immunobiological_product_id, class: "mb-1 block text-sm font-medium" %>
      <%= form.collection_select :immunobiological_product_id, @products, :id, :name, {}, class: "w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :lot_number, class: "mb-1 block text-sm font-medium" %>
      <%= form.text_field :lot_number, required: true, class: "w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :expires_on, class: "mb-1 block text-sm font-medium" %>
      <%= form.date_field :expires_on, required: true, class: "w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :manufacturer, class: "mb-1 block text-sm font-medium" %>
      <%= form.text_field :manufacturer, class: "w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :quantity_on_hand, class: "mb-1 block text-sm font-medium" %>
      <%= form.number_field :quantity_on_hand, min: 0, step: 1, required: true, class: "w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
    <%= form.submit t("cidadaobr.common.save"), class: "rounded bg-emerald-700 px-4 py-2 font-semibold text-white" %>
  <% end %>
</section>
