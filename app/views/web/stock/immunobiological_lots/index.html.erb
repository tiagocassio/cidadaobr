<section>
  <div class="mb-6 flex items-center justify-between">
    <h2 class="text-2xl font-bold"><%= t("cidadaobr.stock.lots.index_title") %></h2>
    <% if municipality_scope? || facility_scope? %>
      <%= link_to t("cidadaobr.stock.lots.new"), new_web_stock_immunobiological_lot_path, class: "rounded bg-emerald-700 px-4 py-2 text-sm font-semibold text-white" %>
    <% end %>
  </div>

  <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
    <table class="min-w-full text-sm">
      <thead class="bg-slate-50 text-left">
        <tr>
          <th class="px-4 py-3"><%= ImmunobiologicalLot.human_attribute_name(:health_facility_id) %></th>
          <th class="px-4 py-3"><%= ImmunobiologicalProduct.model_name.human %></th>
          <th class="px-4 py-3"><%= ImmunobiologicalLot.human_attribute_name(:lot_number) %></th>
          <th class="px-4 py-3"><%= ImmunobiologicalLot.human_attribute_name(:expires_on) %></th>
          <th class="px-4 py-3"><%= ImmunobiologicalLot.human_attribute_name(:quantity_on_hand) %></th>
        </tr>
      </thead>
      <tbody>
        <% @lots.each do |lot| %>
          <tr class="border-t border-slate-100">
            <td class="px-4 py-3"><%= lot.health_facility.name %></td>
            <td class="px-4 py-3"><%= lot.immunobiological_product.name %></td>
            <td class="px-4 py-3"><%= lot.lot_number %></td>
            <td class="px-4 py-3"><%= l(lot.expires_on) %></td>
            <td class="px-4 py-3"><%= lot.quantity_on_hand %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "web/shared/pagination" %>
</section>
