<section>
  <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h2 class="text-2xl font-bold"><%= @citizen.full_name.presence || "Cidadão" %></h2>
      <p class="text-slate-600">CPF: <%= @citizen.cpf.presence || "—" %> · CNS: <%= @citizen.cns.presence || "—" %></p>
    </div>
    <% if municipality_scope? || facility_scope? %>
      <%= link_to "Editar", edit_web_citizen_path(@citizen), class: "rounded border border-slate-300 px-4 py-2 text-sm hover:bg-slate-50" %>
    <% end %>
  </div>

  <div class="mb-8 grid gap-6 lg:grid-cols-2">
    <div class="rounded-lg border border-slate-200 bg-white p-6 text-sm">
      <h3 class="mb-3 font-semibold">Vínculo</h3>
      <p><strong>UBS:</strong> <%= @citizen.health_facility&.name || "—" %></p>
      <p><strong>Equipe:</strong> <%= @citizen.care_team&.name || "—" %></p>
      <p><strong>Nascimento:</strong> <%= @citizen.birth_date&.strftime("%d/%m/%Y") || "—" %></p>
      <p><strong>Sexo:</strong> <%= @citizen.sex.presence || "—" %></p>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white p-6 text-sm">
      <h3 class="mb-3 font-semibold">Domicílios</h3>
      <ul class="mb-4 space-y-2">
        <% @household_members.each do |member| %>
          <li class="flex items-center justify-between gap-2">
            <%= link_to [member.household.street, member.household.street_number].compact.join(", "), web_household_path(member.household), class: "text-emerald-700 hover:underline" %>
            <% if municipality_scope? || facility_scope? %>
              <%= button_to "Remover", web_household_member_path(member), method: :delete, class: "text-red-700 hover:underline", form: { data: { turbo_confirm: "Remover vínculo?" } } %>
            <% end %>
          </li>
        <% end %>
      </ul>

      <% if municipality_scope? || facility_scope? %>
        <%= form_with url: web_citizen_household_members_path(@citizen), class: "space-y-2" do |form| %>
          <%= form.collection_select "household_member[household_id]", @households, :id, ->(h) { [h.street, h.street_number, h.neighborhood].compact.join(" · ") }, { prompt: "Selecionar domicílio" }, class: "w-full rounded border border-slate-300 px-3 py-2", required: true %>
          <%= form.submit "Vincular domicílio", class: "rounded bg-emerald-700 px-3 py-2 text-sm text-white" %>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
