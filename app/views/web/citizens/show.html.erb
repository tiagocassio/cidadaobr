<section>
  <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h2 class="text-2xl font-bold"><%= @citizen.full_name.presence || t("cidadaobr.citizens.fallback_name") %></h2>
      <p class="text-slate-600"><%= Citizen.human_attribute_name(:cpf) %>: <%= @citizen.cpf.presence || t("cidadaobr.common.empty") %> · <%= Citizen.human_attribute_name(:cns) %>: <%= @citizen.cns.presence || t("cidadaobr.common.empty") %></p>
    </div>
    <% if municipality_scope? || facility_scope? %>
      <%= link_to t("cidadaobr.common.edit"), edit_web_citizen_path(@citizen), class: "rounded border border-slate-300 px-4 py-2 text-sm hover:bg-slate-50" %>
    <% end %>
  </div>

  <div class="mb-8 grid gap-6 lg:grid-cols-2">
    <div class="rounded-lg border border-slate-200 bg-white p-6 text-sm">
      <h3 class="mb-3 font-semibold"><%= t("cidadaobr.citizens.affiliation") %></h3>
      <p><strong><%= Citizen.human_attribute_name(:health_facility_id) %>:</strong> <%= @citizen.health_facility&.name || t("cidadaobr.common.empty") %></p>
      <p><strong><%= Citizen.human_attribute_name(:care_team_id) %>:</strong> <%= @citizen.care_team&.name || t("cidadaobr.common.empty") %></p>
      <p><strong><%= Citizen.human_attribute_name(:birth_date) %>:</strong> <%= @citizen.birth_date&.strftime("%d/%m/%Y") || t("cidadaobr.common.empty") %></p>
      <p><strong><%= Citizen.human_attribute_name(:sex) %>:</strong> <%= citizen_sex_label(@citizen.sex) %></p>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white p-6 text-sm">
      <h3 class="mb-3 font-semibold"><%= t("cidadaobr.citizens.households") %></h3>
      <ul class="mb-4 space-y-2">
        <% @household_members.each do |member| %>
          <li class="flex items-center justify-between gap-2">
            <%= link_to [member.household.street, member.household.street_number].compact.join(", "), web_household_path(member.household), class: "text-emerald-700 hover:underline" %>
            <% if member.household.micro_area_code.present? %>
              <span class="text-slate-500">· <%= Household.human_attribute_name(:micro_area_code) %> <%= member.household.micro_area_code %></span>
            <% end %>
            <% if municipality_scope? || facility_scope? %>
              <%= button_to t("cidadaobr.common.remove"), web_household_member_path(member), method: :delete, class: "text-red-700 hover:underline", form: { data: { turbo_confirm: t("cidadaobr.common.confirm_remove_link") } } %>
            <% end %>
          </li>
        <% end %>
      </ul>

      <% if municipality_scope? || facility_scope? %>
        <%= form_with url: web_citizen_household_members_path(@citizen), class: "space-y-2" do |form| %>
          <%= form.collection_select "household_member[household_id]", @households, :id, ->(h) { [h.street, h.street_number, h.neighborhood].compact.join(" · ") }, { prompt: t("cidadaobr.citizens.select_household") }, class: "w-full rounded border border-slate-300 px-3 py-2", required: true %>
          <%= form.submit t("cidadaobr.citizens.link_household"), class: "rounded bg-emerald-700 px-3 py-2 text-sm text-white" %>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
