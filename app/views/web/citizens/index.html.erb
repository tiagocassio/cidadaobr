<section>
  <h2 class="mb-6 text-2xl font-bold">Cidadãos</h2>

  <%= form_with url: web_citizens_path, method: :get, class: "mb-4 flex gap-2" do |form| %>
    <%= form.text_field :q, value: params[:q], placeholder: "Buscar por CPF, CNS ou nome", class: "flex-1 rounded border border-slate-300 px-3 py-2" %>
    <%= form.submit "Buscar", class: "rounded bg-slate-900 px-4 py-2 text-sm text-white" %>
  <% end %>

  <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
    <table class="min-w-full text-sm">
      <thead class="bg-slate-50 text-left">
        <tr>
          <th class="px-4 py-3">Nome</th>
          <th class="px-4 py-3">CPF</th>
          <th class="px-4 py-3">CNS</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody>
        <% @citizens.each do |citizen| %>
          <tr class="border-t border-slate-100">
            <td class="px-4 py-3"><%= citizen.full_name.presence || "—" %></td>
            <td class="px-4 py-3"><%= citizen.cpf %></td>
            <td class="px-4 py-3"><%= citizen.cns %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to "Ver", web_citizen_path(citizen), class: "text-emerald-700 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "web/shared/pagination", collection: @citizens %>
</section>
