<%= form_with model: [:web, @micro_area], class: "max-w-xl space-y-4 rounded-lg border border-slate-200 bg-white p-6" do |form| %>
  <% if @micro_area.errors.any? %>
    <div class="rounded bg-red-50 px-4 py-2 text-sm text-red-800"><%= @micro_area.errors.full_messages.to_sentence %></div>
  <% end %>

  <div>
    <%= form.label :code, class: "mb-1 block text-sm font-medium" %>
    <%= form.text_field :code, required: true, class: "w-full rounded border border-slate-300 px-3 py-2" %>
  </div>
  <div>
    <%= form.label :name, class: "mb-1 block text-sm font-medium" %>
    <%= form.text_field :name, required: true, class: "w-full rounded border border-slate-300 px-3 py-2" %>
  </div>
  <div>
    <%= form.label :care_team_id, class: "mb-1 block text-sm font-medium" %>
    <%= form.collection_select :care_team_id, @care_teams, :id, :name, {}, class: "w-full rounded border border-slate-300 px-3 py-2" %>
  </div>

  <fieldset class="space-y-2 border-t border-slate-200 pt-4">
    <legend class="text-sm font-medium"><%= t("cidadaobr.micro_areas.form.coverage_legend") %></legend>
    <% bbox = @micro_area.coverage_bbox %>
    <div class="grid grid-cols-2 gap-3">
      <%= form.label :coverage_sw_lat, class: "text-xs" %>
      <%= form.text_field :coverage_sw_lat, value: params.dig(:micro_area, :coverage_sw_lat).presence || bbox&.dig(:sw_lat), class: "rounded border border-slate-300 px-3 py-2" %>
      <%= form.label :coverage_sw_lng, class: "text-xs" %>
      <%= form.text_field :coverage_sw_lng, value: params.dig(:micro_area, :coverage_sw_lng).presence || bbox&.dig(:sw_lng), class: "rounded border border-slate-300 px-3 py-2" %>
      <%= form.label :coverage_ne_lat, class: "text-xs" %>
      <%= form.text_field :coverage_ne_lat, value: params.dig(:micro_area, :coverage_ne_lat).presence || bbox&.dig(:ne_lat), class: "rounded border border-slate-300 px-3 py-2" %>
      <%= form.label :coverage_ne_lng, class: "text-xs" %>
      <%= form.text_field :coverage_ne_lng, value: params.dig(:micro_area, :coverage_ne_lng).presence || bbox&.dig(:ne_lng), class: "rounded border border-slate-300 px-3 py-2" %>
    </div>
    <% if @micro_area.persisted? %>
      <label class="flex items-center gap-2 text-sm">
        <%= form.check_box :remove_coverage %>
        <%= t("cidadaobr.micro_areas.form.remove_coverage") %>
      </label>
    <% end %>
  </fieldset>

  <fieldset class="space-y-2 border-t border-slate-200 pt-4">
    <legend class="text-sm font-medium"><%= t("cidadaobr.micro_areas.form.linked_facilities_legend") %></legend>
    <% selected_ids = Array(params.dig(:micro_area, :health_facility_ids)).presence || @micro_area.health_facility_ids %>
    <div class="space-y-2">
      <%= form.collection_check_boxes :health_facility_ids, @health_facilities, :id, :name, { checked: selected_ids } do |facility_box| %>
        <label class="flex items-center gap-2 text-sm">
          <%= facility_box.check_box %>
          <%= facility_box.label %>
        </label>
      <% end %>
    </div>
  </fieldset>

  <%= form.submit t("cidadaobr.common.save"), class: "rounded bg-emerald-700 px-4 py-2 font-semibold text-white" %>
<% end %>
