<section>
  <h2 class="mb-6 text-2xl font-bold"><%= t("cidadaobr.ledi_batches.index_title") %></h2>

  <div class="mb-4 flex flex-wrap gap-2 text-sm">
    <%= link_to t("cidadaobr.common.all"), web_ledi_batches_path, class: "rounded px-3 py-1 #{params[:status].blank? ? 'bg-slate-900 text-white' : 'bg-slate-100'}" %>
    <% LediBatch::STATUSES.each do |status| %>
      <%= link_to ledi_batch_status_label(status), web_ledi_batches_path(status: status), class: "rounded px-3 py-1 #{params[:status] == status ? 'bg-slate-900 text-white' : 'bg-slate-100'}" %>
    <% end %>
  </div>

  <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
    <table class="min-w-full text-sm">
      <thead class="bg-slate-50 text-left">
        <tr>
          <th class="px-4 py-3"><%= t("cidadaobr.ledi_batches.batch_label") %></th>
          <th class="px-4 py-3"><%= t("cidadaobr.ledi_batches.status_label") %></th>
          <th class="px-4 py-3"><%= t("cidadaobr.nav.health_facilities") %></th>
          <th class="px-4 py-3"><%= t("cidadaobr.ledi_batches.version") %></th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody>
        <% @ledi_batches.each do |batch| %>
          <tr class="border-t border-slate-100">
            <td class="px-4 py-3"><%= batch.batch_number %></td>
            <td class="px-4 py-3"><%= ledi_batch_status_label(batch.status) %><% if batch.rejection_reason.present? %> — <%= truncate(batch.rejection_reason, length: 40) %><% end %></td>
            <td class="px-4 py-3"><%= batch.health_facility&.name || t("cidadaobr.common.empty") %></td>
            <td class="px-4 py-3"><%= batch.ledi_version %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to t("cidadaobr.common.view"), web_ledi_batch_path(batch), class: "text-emerald-700 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "web/shared/pagination" %>
</section>
