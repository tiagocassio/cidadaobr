<section>
  <h2 class="mb-2 text-2xl font-bold">Lote <%= @ledi_batch.batch_number %></h2>
  <p class="mb-6 text-slate-600">Status: <%= @ledi_batch.status %> · LEDI <%= @ledi_batch.ledi_version %></p>

  <div class="rounded-lg border border-slate-200 bg-white p-6">
    <h3 class="mb-4 font-semibold">Registros de transporte</h3>
    <ul class="space-y-2 text-sm">
      <% @transport_records.each do |record| %>
        <li class="rounded border border-slate-100 px-3 py-2">
          <%= record.serialized_type %> — <%= record.status %>
          <% if record.clinical_record %>
            <span class="text-slate-500">(<%= record.clinical_record.record_type %> · <%= record.clinical_record.validation_status %>)</span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</section>
