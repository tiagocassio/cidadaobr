<div class="mx-auto max-w-md rounded-lg border border-slate-200 bg-white p-8 shadow-sm">
  <h2 class="mb-2 text-2xl font-bold"><%= t("cidadaobr.brand.management") %></h2>
  <p class="mb-6 text-sm text-slate-600"><%= t("cidadaobr.dashboard.subtitle") %></p>

  <%= form_with url: web_login_path, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :email, User.human_attribute_name(:email), class: "mb-1 block text-sm font-medium" %>
      <%= form.email_field :email, required: true, class: "w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :password, User.human_attribute_name(:password), class: "mb-1 block text-sm font-medium" %>
      <%= form.password_field :password, required: true, class: "w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :municipality_id, t("cidadaobr.sessions.municipality"), class: "mb-1 block text-sm font-medium" %>
      <%= form.text_field :municipality_id, required: true, class: "w-full rounded border border-slate-300 px-3 py-2", placeholder: t("cidadaobr.sessions.municipality_placeholder") %>
    </div>
    <%= form.submit t("cidadaobr.common.sign_in"), class: "w-full rounded bg-emerald-700 px-4 py-2 font-semibold text-white" %>
  <% end %>
</div>
