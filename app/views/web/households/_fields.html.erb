<%# locals: (form:, show_include_toggle: false, include_checked: false) %>
<% household = form.object %>
<% fields_panel_id = "#{form.object_name.tr('[', '_').tr(']', '').tr(',', '_')}-fields-panel" %>

<% if household.errors.any? %>
  <div class="rounded bg-red-50 px-4 py-2 text-sm text-red-800"><%= household.errors.full_messages.to_sentence %></div>
<% end %>

<% if show_include_toggle %>
  <label class="flex items-center gap-2 text-sm font-medium">
    <%= form.check_box :include, { checked: include_checked }, "1", "0" %>
    <%= t("cidadaobr.households.form.include") %>
  </label>
  <p class="text-xs text-slate-600"><%= t("cidadaobr.households.form.fcd_hint") %></p>
<% end %>

<div id="<%= fields_panel_id %>" class="space-y-6<%= " hidden" if show_include_toggle && !include_checked %>">
  <fieldset class="space-y-3">
    <legend class="text-sm font-semibold"><%= t("cidadaobr.households.form.sections.territory") %></legend>
    <% if municipality_scope? %>
      <div>
        <%= form.label :health_facility_id, class: "mb-1 block text-sm font-medium" %>
        <%= form.collection_select :health_facility_id, @health_facilities, :id, :name, { include_blank: t("cidadaobr.common.empty") }, class: "w-full rounded border border-slate-300 px-3 py-2" %>
      </div>
    <% end %>
    <div>
      <%= form.label :care_team_id, class: "mb-1 block text-sm font-medium" %>
      <%= form.collection_select :care_team_id, @care_teams, :id, :name, { include_blank: t("cidadaobr.common.empty") }, class: "w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
    <div>
      <%= form.label :micro_area_code, class: "mb-1 block text-sm font-medium" %>
      <%= form.select :micro_area_code,
                      options_for_select(
                        @micro_areas.map { |ma| [ "#{ma.code} — #{ma.name}", ma.code ] },
                        household.micro_area_code
                      ),
                      { include_blank: t("cidadaobr.common.empty") },
                      class: "w-full rounded border border-slate-300 px-3 py-2" %>
    </div>
    <label class="flex items-center gap-2 text-sm">
      <%= form.check_box :outside_micro_area, class: "rounded border-slate-300" %>
      <%= t("cidadaobr.households.form.outside_micro_area") %>
    </label>
  </fieldset>

  <fieldset class="space-y-3">
    <legend class="text-sm font-semibold"><%= t("cidadaobr.households.form.sections.property") %></legend>
    <div>
      <%= form.label :property_type, class: "mb-1 block text-sm font-medium" %>
      <%= form.select :property_type,
                      options_for_select(fcd_property_type_options, household.property_type),
                      { include_blank: t("cidadaobr.common.empty") },
                      class: "w-full rounded border border-slate-300 px-3 py-2",
                      required: true %>
    </div>
  </fieldset>

  <fieldset class="space-y-3">
    <legend class="text-sm font-semibold"><%= t("cidadaobr.households.form.sections.address") %></legend>
    <p class="text-xs text-slate-500"><%= t("cidadaobr.households.form.address_ledi_hint") %></p>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <%= form.label :street, class: "mb-1 block text-sm font-medium" %>
        <%= form.text_field :street, required: true, class: "w-full rounded border border-slate-300 px-3 py-2" %>
      </div>
      <div>
        <%= form.label :street_number, class: "mb-1 block text-sm font-medium" %>
        <%= form.text_field :street_number, class: "w-full rounded border border-slate-300 px-3 py-2" %>
      </div>
      <div class="flex items-end pb-2">
        <label class="flex items-center gap-2 text-sm">
          <%= form.check_box :no_street_number, class: "rounded border-slate-300" %>
          <%= t("cidadaobr.households.form.no_street_number") %>
        </label>
      </div>
      <div>
        <%= form.label :complement, class: "mb-1 block text-sm font-medium" %>
        <%= form.text_field :complement, class: "w-full rounded border border-slate-300 px-3 py-2" %>
      </div>
      <div>
        <%= form.label :neighborhood, class: "mb-1 block text-sm font-medium" %>
        <%= form.text_field :neighborhood, class: "w-full rounded border border-slate-300 px-3 py-2" %>
      </div>
      <div>
        <%= form.label :postal_code, class: "mb-1 block text-sm font-medium" %>
        <%= form.text_field :postal_code, class: "w-full rounded border border-slate-300 px-3 py-2" %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :reference_point, class: "mb-1 block text-sm font-medium" %>
        <%= form.text_field :reference_point, class: "w-full rounded border border-slate-300 px-3 py-2" %>
      </div>
      <div>
        <%= form.label :contact_phone, class: "mb-1 block text-sm font-medium" %>
        <%= form.text_field :contact_phone, class: "w-full rounded border border-slate-300 px-3 py-2" %>
      </div>
      <div>
        <%= form.label :residence_phone, class: "mb-1 block text-sm font-medium" %>
        <%= form.text_field :residence_phone, class: "w-full rounded border border-slate-300 px-3 py-2" %>
      </div>
    </div>
  </fieldset>

  <fieldset class="space-y-3">
    <legend class="text-sm font-semibold"><%= t("cidadaobr.households.form.sections.coordinates") %></legend>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :latitude, t("cidadaobr.households.form.latitude"), class: "mb-1 block text-sm font-medium" %>
        <%= form.number_field :latitude, step: "any", class: "w-full rounded border border-slate-300 px-3 py-2" %>
      </div>
      <div>
        <%= form.label :longitude, t("cidadaobr.households.form.longitude"), class: "mb-1 block text-sm font-medium" %>
        <%= form.number_field :longitude, step: "any", class: "w-full rounded border border-slate-300 px-3 py-2" %>
      </div>
    </div>
    <p class="text-xs text-slate-500"><%= t("cidadaobr.households.form.coordinates_hint") %></p>
  </fieldset>

  <fieldset class="space-y-3">
    <legend class="text-sm font-semibold"><%= t("cidadaobr.households.form.sections.housing_conditions") %></legend>
    <p class="text-xs text-slate-500"><%= t("cidadaobr.households.form.condicao_moradia_hint") %></p>
    <%= form.fields_for :housing_conditions, household.housing_conditions do |conditions_form| %>
      <div class="grid gap-4 sm:grid-cols-2">
        <% Cidadaobr::LediFcdOptions::HOUSING_CONDITION_FIELDS.each_key do |field| %>
          <div>
            <%= conditions_form.label field, t("cidadaobr.households.form.housing_conditions.#{field}"), class: "mb-1 block text-sm font-medium" %>
            <%= conditions_form.select field,
                                       options_for_select(
                                         fcd_housing_condition_options(field),
                                         household_housing_condition_value(household, field)
                                       ),
                                       { include_blank: t("cidadaobr.common.empty") },
                                       class: "w-full rounded border border-slate-300 px-3 py-2" %>
          </div>
        <% end %>
        <div>
          <%= conditions_form.label :nu_moradores, t("cidadaobr.households.form.housing_conditions.nu_moradores"), class: "mb-1 block text-sm font-medium" %>
          <%= conditions_form.text_field :nu_moradores, class: "w-full rounded border border-slate-300 px-3 py-2" %>
        </div>
        <div>
          <%= conditions_form.label :nu_comodos, t("cidadaobr.households.form.housing_conditions.nu_comodos"), class: "mb-1 block text-sm font-medium" %>
          <%= conditions_form.text_field :nu_comodos, class: "w-full rounded border border-slate-300 px-3 py-2" %>
        </div>
      </div>
    <% end %>
  </fieldset>

  <fieldset class="space-y-3">
    <legend class="text-sm font-semibold"><%= t("cidadaobr.households.form.sections.animals") %></legend>
    <label class="flex items-center gap-2 text-sm">
      <%= form.check_box :animals_on_premises, class: "rounded border-slate-300" %>
      <%= t("cidadaobr.households.form.animals_on_premises") %>
    </label>
  </fieldset>

  <% if show_include_toggle %>
    <fieldset class="space-y-2">
      <legend class="text-sm font-semibold"><%= t("cidadaobr.households.form.sections.family") %></legend>
      <label class="flex items-center gap-2 text-sm">
        <%= form.check_box :family_reference, class: "rounded border-slate-300" %>
        <%= t("cidadaobr.households.form.family_reference") %>
      </label>
    </fieldset>
  <% end %>
</div>

<% if show_include_toggle %>
  <script>
    (function () {
      var toggle = document.querySelector('input[name="<%= form.object_name %>[include]"]');
      var panel = document.getElementById("<%= fields_panel_id %>");
      if (!toggle || !panel) return;
      toggle.addEventListener("change", function () {
        panel.classList.toggle("hidden", !toggle.checked);
      });
    })();
  </script>
<% end %>
