<section>
  <div class="mb-6 flex items-center justify-between">
    <h2 class="text-2xl font-bold">Domicílios</h2>
    <%= link_to "Ver mapa", map_web_households_path, class: "rounded border border-slate-300 px-4 py-2 text-sm" %>
  </div>

  <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
    <table class="min-w-full text-sm">
      <thead class="bg-slate-50 text-left">
        <tr>
          <th class="px-4 py-3">Endereço</th>
          <th class="px-4 py-3">Bairro</th>
          <th class="px-4 py-3">UBS</th>
          <th class="px-4 py-3">Geo</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody>
        <% @households.each do |household| %>
          <tr class="border-t border-slate-100">
            <td class="px-4 py-3"><%= [household.street, household.street_number].compact.join(", ") %></td>
            <td class="px-4 py-3"><%= household.neighborhood %></td>
            <td class="px-4 py-3"><%= household.health_facility&.name %></td>
            <td class="px-4 py-3"><%= household.location.present? ? "Sim" : "—" %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to "Ver", web_household_path(household), class: "text-emerald-700 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "web/shared/pagination" %>
</section>
