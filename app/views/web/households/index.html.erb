<section>
  <div class="mb-6 flex items-center justify-between">
    <h2 class="text-2xl font-bold"><%= t("cidadaobr.households.index_title") %></h2>
    <%= link_to t("cidadaobr.households.view_map"), map_web_households_path, class: "rounded border border-slate-300 px-4 py-2 text-sm" %>
  </div>

  <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
    <table class="min-w-full text-sm">
      <thead class="bg-slate-50 text-left">
        <tr>
          <th class="px-4 py-3"><%= t("cidadaobr.households.table.address") %></th>
          <th class="px-4 py-3"><%= t("cidadaobr.households.table.neighborhood") %></th>
          <th class="px-4 py-3"><%= Household.human_attribute_name(:health_facility_id) %></th>
          <th class="px-4 py-3"><%= t("cidadaobr.households.table.geo") %></th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody>
        <% @households.each do |household| %>
          <tr class="border-t border-slate-100">
            <td class="px-4 py-3"><%= [household.street, household.street_number].compact.join(", ") %></td>
            <td class="px-4 py-3"><%= household.neighborhood %></td>
            <td class="px-4 py-3"><%= household.health_facility&.name %></td>
            <td class="px-4 py-3"><%= household.location.present? ? t("cidadaobr.common.yes") : t("cidadaobr.common.empty") %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to t("cidadaobr.common.view"), web_household_path(household), class: "text-emerald-700 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "web/shared/pagination" %>
</section>
