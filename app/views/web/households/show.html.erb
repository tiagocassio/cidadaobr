<section>
  <h2 class="mb-2 text-2xl font-bold">Domicílio</h2>
  <p class="mb-6 text-slate-600">
    <%= [@household.street, @household.street_number, @household.neighborhood].compact.join(" · ") %>
  </p>

  <div class="mb-8 grid gap-6 lg:grid-cols-2">
    <div class="rounded-lg border border-slate-200 bg-white p-6 text-sm">
      <h3 class="mb-3 font-semibold">Membros</h3>
      <ul class="space-y-2">
        <% @household.household_members.includes(:citizen).each do |member| %>
          <li>
            <%= link_to member.citizen.full_name.presence || member.citizen.cpf || member.citizen.cns, web_citizen_path(member.citizen), class: "text-emerald-700 hover:underline" %>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="rounded-lg border border-slate-200 bg-white p-6 text-sm">
      <h3 class="mb-3 font-semibold">Animais no domicílio</h3>
      <ul class="mb-4 space-y-2">
        <% @household_animals.each do |animal| %>
          <li class="flex items-center justify-between">
            <span><%= animal.species %> (<%= animal.quantity %>)</span>
            <%= button_to "Remover", web_household_animal_path(animal), method: :delete, class: "text-red-700 hover:underline", form: { data: { turbo_confirm: "Remover?" } } %>
          </li>
        <% end %>
      </ul>

      <%= form_with model: [@household, @household_animal], url: web_household_household_animals_path(@household), class: "space-y-2" do |form| %>
        <%= form.text_field :species, placeholder: "Espécie", required: true, class: "w-full rounded border border-slate-300 px-3 py-2" %>
        <%= form.number_field :quantity, min: 1, value: 1, class: "w-full rounded border border-slate-300 px-3 py-2" %>
        <%= form.submit "Adicionar animal", class: "rounded bg-emerald-700 px-3 py-2 text-sm text-white" %>
      <% end %>
    </div>
  </div>
</section>
